[includeIf "gitdir:~/Developer/cro-metrics-code/"]
    path = ~/dotfiles/user.config/.gitconfig-crometrics-code

[includeIf "gitdir:~/Developer/personal/"]
    path = ~/dotfiles/user.config/.gitconfig-ryanzigler

[includeIf "gitdir:~/Developer/work/"]
    path = ~/dotfiles/user.config/.gitconfig-ryanzigler

[core]
    excludesFile = ~/dotfiles/.gitignore_global

[filter "lfs"]
    clean = "git-lfs clean -- %f"
    smudge = "git-lfs smudge -- %f"
    process = "git-lfs filter-process"
    required = true

[user]
    email = rpzigler@gmail.com
    name = Ryan Zigler

[alias]
    cleanup = "!sh -c 'git remote prune origin && git branch -vv | grep \": gone]\" | awk \"{print \\$1}\" | xargs -r git branch -d'"
    helper = store
